# IT8417 - Week 10 - Streamlit secrets template
#
# 1. Create a folder called .streamlit next to app.py
# 2. Copy this file into it and rename it to secrets.toml
# 3. Replace every placeholder with YOUR OWN values (the same values you typed into DBeaver / DbGate)
#
# NEVER commit secrets.toml to Git and never paste its content into a chat or a report.
# Only this example file (with fake values) is safe to share.

# ---------------------------------------------------------------- Supabase PostgreSQL
# Supabase dashboard -> Connect -> "Session pooler".  It works over IPv4 (the direct
# connection db.<ref>.supabase.co is IPv6-only and fails on many networks).
[supabase]
host     = "aws-0-REGION.pooler.supabase.com"   # the pooler host shown on the Connect page
port     = 5432                                  # session pooler: 5432   (transaction pooler: 6543)
database = "postgres"
user     = "postgres.YOUR-PROJECT-REF"           # note: postgres.<project-ref>, not just postgres
password = "YOUR-DATABASE-PASSWORD"

# ---------------------------------------------------------------- Databricks
# SQL Warehouses -> your warehouse -> Connection details.  Token: your name (top right)
# -> Settings -> Developer -> Access tokens -> Generate new token.
[databricks]
server_hostname = "dbc-xxxxxxxx-xxxx.cloud.databricks.com"
http_path       = "/sql/1.0/warehouses/xxxxxxxxxxxxxxxx"
access_token    = "dapiYOUR-PERSONAL-ACCESS-TOKEN"
# catalog = "workspace"     # optional: only if your Week 3-4 tables are not in the default catalog
# schema  = "default"       # optional: the schema that holds fact_rental, dim_film ...

# ---------------------------------------------------------------- MongoDB Atlas
# Atlas -> Database -> Connect -> Drivers -> copy the mongodb+srv:// string and insert your
# DATABASE USER password (this is the Database Access user, NOT your Atlas login).
# A password with special characters (@ : / ?) must be URL-encoded, or choose a simpler one.
[mongodb]
uri      = "mongodb+srv://YOUR-DB-USER:YOUR-DB-PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority"
database = "it8417_db"
